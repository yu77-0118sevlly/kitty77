(function() {
    window.addEventListener('DOMContentLoaded', () => {
        const calApp = document.getElementById('calendar-app');
        if (!calApp) return;

        let currentDate = new Date();
        let selectedDateStr = formatDateKey(currentDate);

        const monthNames = ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'];

        function formatDateKey(d) {
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        }

        window.renderCalendarInstance = function() {
            renderCalendar();
            if (window.lucide) lucide.createIcons();
        };

        window.closeCalendar = function() {
            calApp.style.display = 'none';
            const homeScreen = document.getElementById('home-screen');
            if (homeScreen) homeScreen.style.display = 'flex';
        };

        const todayBtn = document.getElementById('cal-today-btn');
        if (todayBtn) {
            todayBtn.addEventListener('click', () => {
                currentDate = new Date();
                selectedDateStr = formatDateKey(currentDate);
                renderCalendar();
            });
        }

        function renderCalendar() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            
            document.getElementById('cal-year-title').textContent = `${year}年`;
            document.getElementById('cal-month-large-title').textContent = monthNames[month];

            renderMonthView(year, month);
        }

        function renderMonthView(year, month) {
            const grid = document.getElementById('cal-days-grid');
            if (!grid) return;
            grid.innerHTML = '';

            const firstDayIndex = new Date(year, month, 1).getDay();
            const totalDays = new Date(year, month + 1, 0).getDate();
            const prevTotalDays = new Date(year, month, 0).getDate();
            const todayKey = formatDateKey(new Date());

            // 1. 上月留白
            for (let i = firstDayIndex - 1; i >= 0; i--) {
                grid.appendChild(createCell(prevTotalDays - i, true, null));
            }
            // 2. 当月日期
            for (let d = 1; d <= totalDays; d++) {
                const dateKey = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
                grid.appendChild(createCell(d, false, dateKey, dateKey === todayKey));
            }
            // 3. 下月留白
            const totalCells = firstDayIndex + totalDays;
            const nextDays = totalCells <= 35 ? 35 - totalCells : 42 - totalCells;
            for (let d = 1; d <= nextDays; d++) {
                grid.appendChild(createCell(d, true, null));
            }
        }

        function createCell(dayNum, isOtherMonth, dateKey, isToday = false) {
            const cell = document.createElement('div');
            cell.className = `cal-day-cell ${isOtherMonth ? 'other-month' : ''} ${isToday ? 'today' : ''} ${dateKey === selectedDateStr ? 'selected' : ''}`;
            
            if (dateKey) {
                cell.addEventListener('click', () => {
                    selectedDateStr = dateKey;
                    renderCalendar(); // 重新渲染高亮
                });
            }
            cell.innerHTML = `<div class="cal-day-num">${dayNum}</div>`;
            return cell;
        }

        // ==========================================
        // 💥 丝滑的上下滑动切换月份逻辑
        // ==========================================
        const scrollArea = document.getElementById('cal-scroll-area');
        const grid = document.getElementById('cal-days-grid');
        let startY = 0;

        scrollArea.addEventListener('touchstart', (e) => {
            startY = e.touches[0].clientY;
            grid.style.transition = 'none'; // 触摸时取消动画
        }, {passive: true});

        scrollArea.addEventListener('touchend', (e) => {
            let endY = e.changedTouches[0].clientY;
            let diff = startY - endY;

            if (diff > 60) {
                // 向上滑动 -> 下个月
                grid.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
                grid.style.transform = 'translateY(-40px)';
                grid.style.opacity = '0';
                
                setTimeout(() => {
                    currentDate.setMonth(currentDate.getMonth() + 1);
                    renderCalendar();
                    
                    grid.style.transition = 'none';
                    grid.style.transform = 'translateY(40px)';
                    
                    setTimeout(() => {
                        grid.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
                        grid.style.transform = 'translateY(0)';
                        grid.style.opacity = '1';
                    }, 20);
                }, 300);
            } 
            else if (diff < -60) {
                // 向下滑动 -> 上个月
                grid.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
                grid.style.transform = 'translateY(40px)';
                grid.style.opacity = '0';
                
                setTimeout(() => {
                    currentDate.setMonth(currentDate.getMonth() - 1);
                    renderCalendar();
                    
                    grid.style.transition = 'none';
                    grid.style.transform = 'translateY(-40px)';
                    
                    setTimeout(() => {
                        grid.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
                        grid.style.transform = 'translateY(0)';
                        grid.style.opacity = '1';
                    }, 20);
                }, 300);
            }
        });

    });
})();
