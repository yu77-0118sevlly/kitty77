(function() {
    window.addEventListener('DOMContentLoaded', () => {
        const calApp = document.getElementById('calendar-app');
        if (!calApp) return;

        // 状态管理
        let currentDate = new Date();
        let selectedDateStr = formatDateKey(currentDate);

        function formatDateKey(d) {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // 联动 WUYO OS 的打开与关闭
        const originalOpenApp = window.openApp;
        window.openApp = function(appId) {
            if (typeof originalOpenApp === 'function') originalOpenApp(appId);
            if (appId === 'calendar') {
                calApp.style.display = 'block';
                setTimeout(() => {
                    calApp.classList.add('active');
                    renderCalendar();
                }, 10);
            }
        };

        window.closeCalendar = function() {
            calApp.classList.remove('active');
            setTimeout(() => {
                calApp.style.display = 'none';
                const homeScreen = document.getElementById('home-screen');
                if (homeScreen) homeScreen.style.display = 'flex';
            }, 300);
        };

        // 按钮事件绑定
        const prevBtn = document.getElementById('cal-prev-btn');
        const nextBtn = document.getElementById('cal-next-btn');
        const todayBtn = document.getElementById('cal-today-jump');

        if (prevBtn) prevBtn.addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar();
        });

        if (nextBtn) nextBtn.addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar();
        });

        if (todayBtn) todayBtn.addEventListener('click', () => {
            currentDate = new Date();
            selectedDateStr = formatDateKey(currentDate);
            renderCalendar();
        });

        function renderCalendar() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            const titleEl = document.getElementById('cal-header-month-title');
            if (titleEl) titleEl.textContent = `${year}年${month + 1}月`;

            renderMonthView(year, month);
            renderAgendaInfo(selectedDateStr);
        }

        function renderMonthView(year, month) {
            const grid = document.getElementById('cal-days-grid');
            if (!grid) return;
            grid.innerHTML = '';

            const firstDayIndex = new Date(year, month, 1).getDay();
            const totalDays = new Date(year, month + 1, 0).getDate();
            const prevTotalDays = new Date(year, month, 0).getDate();
            const todayKey = formatDateKey(new Date());

            // 上个月补白
            for (let i = firstDayIndex - 1; i >= 0; i--) {
                grid.appendChild(createCell(prevTotalDays - i, true, null));
            }

            // 当月天数
            for (let d = 1; d <= totalDays; d++) {
                const dateKey = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
                grid.appendChild(createCell(d, false, dateKey, dateKey === todayKey));
            }

            // 下个月补白凑满 42 格
            const totalCells = firstDayIndex + totalDays;
            const nextDays = totalCells <= 35 ? 35 - totalCells : 42 - totalCells;
            for (let d = 1; d <= nextDays; d++) {
                grid.appendChild(createCell(d, true, null));
            }
        }

        function createCell(dayNum, isOtherMonth, dateKey, isToday = false) {
            const cell = document.createElement('div');
            cell.className = `cal-day-cell ${isOtherMonth ? 'other-month' : ''} ${isToday ? 'today' : ''} ${dateKey === selectedDateStr ? 'selected' : ''}`;
            
            if (dateKey) {
                cell.addEventListener('click', () => {
                    selectedDateStr = dateKey;
                    currentDate = new Date(dateKey);
                    renderCalendar();
                });
            }

            cell.innerHTML = `<span class="cal-day-num">${dayNum}</span>`;
            return cell;
        }

        function renderAgendaInfo(dateKey) {
            const labelEl = document.getElementById('cal-selected-date-label');
            const boxEl = document.getElementById('cal-agenda-box');
            if (!labelEl || !boxEl) return;

            const d = new Date(dateKey);
            const weekdays = ['星期日','星期一','星期二','星期三','星期四','星期五','星期六'];
            labelEl.textContent = `${d.getFullYear()}年${d.getMonth()+1}月${d.getDate()}日 ${weekdays[d.getDay()]}`;
            boxEl.textContent = `这一天暂无其他安排，点击上方格子可自由切换查看。`;
        }
    });
})();
