/* ==========================================
   WUYO OS - 极简纯净日历 CSS
========================================== */
.calendar-app {
    position: fixed !important;
    top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
    width: 100vw !important; height: 100vh !important;
    background: #FFFFFF !important;
    z-index: 9999 !important;
    display: flex !important;
    flex-direction: column !important;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
    color: #1C1C1E;
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    transform: translateX(100%);
}
.calendar-app.active {
    transform: translateX(0);
}

/* 顶部 Header */
.cal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: calc(env(safe-area-inset-top, 44px) + 8px) 16px 12px 16px;
    background: #FFFFFF;
    border-bottom: 0.5px solid rgba(0,0,0,0.08);
}
.cal-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}
.cal-title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.5px;
}
.cal-icon-btn {
    background: none;
    border: none;
    font-size: 18px;
    color: #1C1C1E;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* 工具栏：年月导航与今天按钮 */
.cal-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: #FAFAFC;
    border-bottom: 0.5px solid rgba(0,0,0,0.05);
}
.cal-nav-group {
    display: flex;
    align-items: center;
    gap: 12px;
}
.cal-today-btn {
    background: #F4F4F7;
    border: 0.5px solid rgba(0,0,0,0.1);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}

/* 主滚动体与月视图网格 */
.cal-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
}
.cal-month-view {
    display: flex;
    flex-direction: column;
    padding: 12px;
}
.cal-weekdays-header {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: #8E8E93;
    padding-bottom: 8px;
}
.cal-days-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
}
.cal-day-cell {
    aspect-ratio: 1 / 1.2;
    background: #FAFAFC;
    border-radius: 8px;
    padding: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    border: 0.5px solid transparent;
}
.cal-day-cell.other-month {
    opacity: 0.25;
}
.cal-day-cell.today {
    border-color: #1C1C1E;
    background: #FFFFFF;
}
.cal-day-cell.selected {
    background: #1C1C1E !important;
    color: #FFFFFF !important;
}
.cal-day-cell.selected .cal-day-num {
    color: #FFFFFF !important;
}
.cal-day-num {
    font-size: 15px;
    font-weight: 600;
    margin-top: 2px;
}

/* 下方日期详情与查看区 */
.cal-agenda-section {
    border-top: 0.5px solid rgba(0,0,0,0.08);
    background: #FFFFFF;
    padding: 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
}
.cal-agenda-header {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 12px;
    color: #1C1C1E;
}
.cal-agenda-box {
    background: #F4F4F7;
    border-radius: 12px;
    padding: 16px;
    font-size: 14px;
    color: #3A3A3C;
    text-align: center;
}
