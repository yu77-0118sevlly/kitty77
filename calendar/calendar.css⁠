/* ==========================================
   苹果原生极简黑白灰日历样式 (剥离版)
========================================== */
.calendar-app {
    position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
    width: 100vw !important; height: 100vh !important; background: #FFFFFF !important; z-index: 9999 !important;
    display: flex !important; flex-direction: column !important;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
    color: #1C1C1E; user-select: none; -webkit-user-select: none;
}

/* 顶部导航 */
.cal-ios-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: calc(env(safe-area-inset-top, 44px) + 10px) 16px 5px; background: #FFFFFF;
}
.cal-ios-back {
    display: flex; align-items: center; gap: 2px; color: #1C1C1E; font-size: 17px; background: none; border: none; padding: 0; cursor: pointer;
}
.cal-ios-back i { width: 24px; height: 24px; }
.cal-ios-tools { display: flex; gap: 22px; color: #1C1C1E; }
.cal-ios-tools i { width: 22px; height: 22px; }

/* 月份大标题 */
.cal-ios-title-row { padding: 5px 16px 12px; }
.cal-ios-title-row h1 { font-size: 34px; font-weight: 800; color: #1C1C1E; margin: 0; letter-spacing: 1px; }

/* 星期表头 */
.cal-ios-weekdays {
    display: grid; grid-template-columns: repeat(7, 1fr); text-align: center;
    font-size: 11px; font-weight: 500; color: #8E8E93; padding: 5px 0 8px;
    border-bottom: 0.5px solid rgba(0,0,0,0.1); margin: 0 16px;
}

/* 核心滑动区 */
.cal-ios-scroll-area {
    flex: 1; position: relative; overflow: hidden; background: #FFFFFF; touch-action: pan-y;
}
.cal-ios-grid {
    display: grid; grid-template-columns: repeat(7, 1fr);
    padding: 12px 16px; row-gap: 16px;
    transition: transform 0.3s ease, opacity 0.3s ease;
}
.cal-day-cell {
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    height: 44px; cursor: pointer; position: relative;
}
.cal-day-num {
    font-size: 20px; font-weight: 400; color: #1C1C1E;
    width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%;
}
.cal-day-cell.other-month .cal-day-num { color: #D1D1D6; }
.cal-day-cell.today .cal-day-num { background: #1C1C1E; color: #FFFFFF; font-weight: 600; }
.cal-day-cell.selected:not(.today) .cal-day-num { background: #F2F2F7; color: #1C1C1E; }

/* 底部 Tab 栏 */
.cal-ios-tabbar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 24px calc(env(safe-area-inset-bottom, 20px) + 12px);
    background: rgba(249, 249, 249, 0.9); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-top: 0.5px solid rgba(0,0,0,0.1);
}
.cal-ios-tabbar button {
    background: none; border: none; font-size: 16px; font-weight: 400; color: #1C1C1E; cursor: pointer;
}
