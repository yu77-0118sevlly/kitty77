/* ==========================================
   WUYO OS - 日历 App 极简高级黑白灰样式
========================================== */
.calendar-app {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    transform: translateX(100%);
    z-index: 50;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
    color: #1C1C1E;
}
.calendar-app.active {
    transform: translateX(0);
}

/* 顶部 Header */
.cal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: calc(env(safe-area-inset-top, 44px) + 8px) 16px 12px 16px;
    background: #FFFFFF;
    border-bottom: 0.5px solid rgba(0,0,0,0.08);
}
.cal-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}
.cal-title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.5px;
}
.cal-header-right {
    display: flex;
    align-items: center;
    gap: 16px;
}
.cal-icon-btn {
    background: none;
    border: none;
    font-size: 18px;
    color: #1C1C1E;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.cal-icon-btn i { width: 20px; height: 20px; }

/* 视图切换与工具栏 */
.cal-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    background: #FAFAFC;
    border-bottom: 0.5px solid rgba(0,0,0,0.05);
}
.cal-view-switch {
    display: flex;
    background: #E5E5EA;
    border-radius: 8px;
    padding: 2px;
}
.cal-view-btn {
    background: transparent;
    border: none;
    padding: 4px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #8E8E93;
    border-radius: 6px;
    cursor: pointer;
    transition: 0.2s;
}
.cal-view-btn.active {
    background: #FFFFFF;
    color: #1C1C1E;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.cal-nav-group {
    display: flex;
    align-items: center;
    gap: 12px;
}
.cal-today-btn {
    background: #F4F4F7;
    border: 0.5px solid rgba(0,0,0,0.1);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}

/* 主滚动体 */
.cal-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
}

/* 月视图样式 */
.cal-month-view {
    display: flex;
    flex-direction: column;
    padding: 8px 12px;
}
.cal-weekdays-header {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: #8E8E93;
    padding: 8px 0;
}
.cal-days-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
}
.cal-day-cell {
    aspect-ratio: 1 / 1.15;
    background: #FAFAFC;
    border-radius: 8px;
    padding: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    position: relative;
    border: 0.5px solid transparent;
}
.cal-day-cell.other-month {
    opacity: 0.3;
}
.cal-day-cell.today {
    border-color: #1C1C1E;
    background: #FFFFFF;
}
.cal-day-cell.selected {
    background: #1C1C1E !important;
    color: #FFFFFF !important;
}
.cal-day-cell.selected .cal-day-num {
    color: #FFFFFF !important;
}
.cal-day-cell.selected .cal-event-dot {
    background: #FFFFFF !important;
}
.cal-day-num {
    font-size: 14px;
    font-weight: 600;
    margin-top: 2px;
}
.cal-day-dots {
    display: flex;
    gap: 2px;
    margin-top: 4px;
    max-width: 100%;
    overflow: hidden;
    height: 6px;
    align-items: center;
}
.cal-event-dot {
    width: 4px; height: 4px; border-radius: 50%;
    background: #1C1C1E;
}

/* 日期详情与日程列表区 */
.cal-agenda-section {
    border-top: 0.5px solid rgba(0,0,0,0.08);
    background: #FFFFFF;
    padding: 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
}
.cal-agenda-header {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.cal-agenda-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow-y: auto;
}
.cal-event-card {
    background: #F4F4F7;
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-left: 4px solid #1C1C1E;
    cursor: pointer;
    transition: 0.2s;
}
.cal-event-card:active { transform: scale(0.98); }
.cal-event-time { font-size: 12px; color: #8E8E93; font-weight: 600; }
.cal-event-title { font-size: 15px; font-weight: 600; color: #1C1C1E; }
.cal-event-desc { font-size: 13px; color: #3A3A3C; }

/* 周视图 & 日视图容器 */
.cal-week-view, .cal-day-timeline-view {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.timeline-hour-row {
    display: flex;
    border-bottom: 0.5px solid rgba(0,0,0,0.05);
    min-height: 60px;
}
.timeline-time-label {
    width: 60px;
    font-size: 12px;
    color: #8E8E93;
    padding-top: 4px;
    font-weight: 600;
}
.timeline-content-area {
    flex: 1;
    position: relative;
    padding-left: 8px;
}

/* 弹窗模态框 (新建、编辑、Todo、搜索等) */
.cal-modal {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    z-index: 100;
    display: flex;
    align-items: flex-end;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
}
.cal-modal.active {
    opacity: 1;
    pointer-events: auto;
}
.cal-modal-box {
    background: #FFFFFF;
    width: 100%;
    max-height: 90vh;
    border-radius: 24px 24px 0 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    overflow-y: auto;
}
.cal-modal.active .cal-modal-box {
    transform: translateY(0);
}
.cal-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.cal-modal-title {
    font-size: 18px;
    font-weight: 700;
}
.cal-form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.cal-form-label {
    font-size: 13px;
    font-weight: 600;
    color: #8E8E93;
}
.cal-input, .cal-select, .cal-textarea {
    background: #F4F4F7;
    border: 0.5px solid rgba(0,0,0,0.1);
    border-radius: 10px;
    padding: 12px;
    font-size: 15px;
    color: #1C1C1E;
    outline: none;
    font-family: inherit;
}
.cal-btn-primary {
    background: #1C1C1E;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 14px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
}
.cal-btn-primary:active { opacity: 0.8; }

/* Todo 视图卡片 */
.todo-container {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.todo-item {
    background: #F4F4F7;
    padding: 12px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.todo-left {
    display: flex;
    align-items: center;
    gap: 12px;
}
.todo-checkbox {
    width: 20px; height: 20px;
    border-radius: 50%;
    border: 2px solid #1C1C1E;
    cursor: pointer;
    display: flex; justify-content: center; align-items: center;
}
.todo-item.completed .todo-text {
    text-decoration: line-through;
    color: #8E8E93;
}
.todo-item.completed .todo-checkbox {
    background: #1C1C1E;
    color: #FFF;
}
/* ==========================================
   💥 修复弹窗默认隐藏与定位补丁
========================================== */
.calendar-app {
    position: fixed !important;
    top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
    width: 100vw !important; height: 100vh !important;
    background: #FFFFFF !important;
    z-index: 9999 !important;
    display: flex !important;
    flex-direction: column !important;
    overflow-y: auto !important;
}

/* 强制让所有弹窗默认隐藏，只有带 active 时才弹出 */
.cal-modal {
    position: fixed !important;
    top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
    background: rgba(0,0,0,0.4) !important;
    backdrop-filter: blur(5px) !important;
    -webkit-backdrop-filter: blur(5px) !important;
    z-index: 10000 !important;
    display: flex !important;
    align-items: flex-end !important;
    opacity: 0 !important;
    pointer-events: none !important;
    transition: opacity 0.3s ease !important;
}

.cal-modal.active {
    opacity: 1 !important;
    pointer-events: auto !important;
}

.cal-modal-box {
    background: #FFFFFF !important;
    width: 100% !important;
    max-height: 85vh !important;
    border-radius: 24px 24px 0 0 !important;
    padding: 20px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 16px !important;
    transform: translateY(100%) !important;
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
    overflow-y: auto !important;
}

.cal-modal.active .cal-modal-box {
    transform: translateY(0) !important;
}

